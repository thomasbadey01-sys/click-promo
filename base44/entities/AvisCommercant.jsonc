{
  "name": "AvisCommercant",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "commercant_id": {
      "type": "string"
    },
    "note": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "commentaire": {
      "type": "string"
    },
    "date_avis": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "commercant_id",
    "note"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}