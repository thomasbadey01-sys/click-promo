{
  "name": "HistoriqueOffresVues",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "offre_id": {
      "type": "string"
    },
    "offre_titre": {
      "type": "string"
    },
    "commercant_nom": {
      "type": "string"
    },
    "ville": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "date_vue": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "offre_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}