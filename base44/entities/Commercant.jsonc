{
  "name": "Commercant",
  "properties": {
    "adresse": {
      "title": "Adresse",
      "type": "string"
    },
    "categorie": {
      "title": "Catégorie",
      "type": "string"
    },
    "code_postal": {
      "title": "Code postal",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "est_actif": {
      "default": true,
      "title": "Actif",
      "type": "boolean"
    },
    "est_valide": {
      "default": false,
      "type": "boolean"
    },
    "est_verifie": {
      "default": false,
      "title": "Vérifié",
      "type": "boolean"
    },
    "horaires_dim": {
      "title": "Dimanche",
      "type": "string"
    },
    "horaires_jeu": {
      "title": "Jeudi",
      "type": "string"
    },
    "horaires_lun": {
      "title": "Lundi",
      "type": "string"
    },
    "horaires_mar": {
      "title": "Mardi",
      "type": "string"
    },
    "horaires_mer": {
      "title": "Mercredi",
      "type": "string"
    },
    "horaires_sam": {
      "title": "Samedi",
      "type": "string"
    },
    "horaires_ven": {
      "title": "Vendredi",
      "type": "string"
    },
    "image_url": {
      "title": "Photo principale",
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "logo_url": {
      "type": "string"
    },
    "longitude": {
      "type": "number"
    },
    "nb_avis": {
      "default": 0,
      "title": "Nombre d'avis",
      "type": "number"
    },
    "nom": {
      "title": "Nom du commerce",
      "type": "string"
    },
    "note_moyenne": {
      "title": "Note moyenne",
      "type": "number"
    },
    "plan_abonnement": {
      "default": "gratuit",
      "enum": [
        "gratuit",
        "starter",
        "pro",
        "business"
      ],
      "type": "string"
    },
    "siret": {
      "title": "SIRET",
      "type": "string"
    },
    "site_web": {
      "type": "string"
    },
    "telephone": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "ville": {
      "title": "Ville",
      "type": "string"
    }
  },
  "required": [
    "nom",
    "categorie"
  ],
  "type": "object",
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
