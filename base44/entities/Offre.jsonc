{
  "name": "Offre",
  "properties": {
    "achat_en_ligne": {
      "default": false,
      "title": "Achat en ligne",
      "type": "boolean"
    },
    "adresse": {
      "title": "Adresse",
      "type": "string"
    },
    "categorie": {
      "enum": [
        "Restaurant",
        "Boutique",
        "Beauté & Coiffure",
        "Fitness & Sport",
        "Épicerie",
        "Services",
        "Pharmacie",
        "Autre"
      ],
      "title": "Catégorie",
      "type": "string"
    },
    "code_promo": {
      "title": "Code promo",
      "type": "string"
    },
    "commercant_id": {
      "title": "ID Commerçant",
      "type": "string"
    },
    "commercant_nom": {
      "title": "Nom du commerce",
      "type": "string"
    },
    "conditions": {
      "title": "Conditions d'utilisation",
      "type": "string"
    },
    "date_debut": {
      "format": "date-time",
      "title": "Date début",
      "type": "string"
    },
    "date_fin": {
      "format": "date-time",
      "title": "Date fin",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "enseigne": {
      "enum": [
        "Carrefour",
        "Auchan",
        "Leclerc",
        "Lidl",
        "Intermarché",
        "Monoprix",
        "Casino",
        "Picard",
        "IKEA",
        "Leroy Merlin",
        "Decathlon",
        "Zara",
        "H&M",
        "Uniqlo",
        "Fnac",
        "Darty",
        "Sephora",
        "Nocibé",
        "Go Sport",
        "McDonald's",
        "Autre"
      ],
      "title": "Enseigne (marque nationale)",
      "type": "string"
    },
    "est_active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "est_urgente": {
      "default": false,
      "title": "Offre flash",
      "type": "boolean"
    },
    "image_url": {
      "title": "Image URL",
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "nb_clics": {
      "default": 0,
      "title": "Clics",
      "type": "number"
    },
    "nb_conversions": {
      "default": 0,
      "title": "Conversions",
      "type": "number"
    },
    "nb_vues": {
      "default": 0,
      "title": "Vues",
      "type": "number"
    },
    "prix_original": {
      "title": "Prix original (€)",
      "type": "number"
    },
    "prix_promo": {
      "title": "Prix promo (€)",
      "type": "number"
    },
    "rayon_km": {
      "default": 10,
      "title": "Rayon de diffusion (km)",
      "type": "number"
    },
    "stock_initial": {
      "title": "Stock initial",
      "type": "number"
    },
    "stock_restant": {
      "title": "Stock restant",
      "type": "number"
    },
    "titre": {
      "title": "Titre de l'offre",
      "type": "string"
    },
    "type_reduction": {
      "enum": [
        "pourcentage",
        "montant"
      ],
      "title": "Type de réduction",
      "type": "string"
    },
    "valeur_reduction": {
      "title": "Valeur réduction",
      "type": "number"
    },
    "ville": {
      "title": "Ville",
      "type": "string"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Photos de l’offre"
    },
    "owner_id": {
      "type": "string",
      "title": "Compte propriétaire"
    }
  },
  "required": [
    "titre",
    "categorie",
    "est_active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
