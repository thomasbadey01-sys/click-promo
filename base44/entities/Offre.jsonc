{
  "name": "Offre",
  "type": "object",
  "properties": {
    "achat_en_ligne": {
      "type": "boolean",
      "title": "Achat en ligne",
      "default": false
    },
    "adresse": {
      "type": "string",
      "title": "Adresse"
    },
    "categorie": {
      "type": "string",
      "title": "Cat\u00e9gorie",
      "enum": [
        "Restaurant",
        "Boutique",
        "Beaut\u00e9 & Coiffure",
        "Fitness & Sport",
        "\u00c9picerie",
        "Services",
        "Pharmacie",
        "Autre"
      ]
    },
    "code_promo": {
      "type": "string",
      "title": "Code promo"
    },
    "commercant_id": {
      "type": "string",
      "title": "ID Commer\u00e7ant"
    },
    "commercant_nom": {
      "type": "string",
      "title": "Nom du commerce"
    },
    "conditions": {
      "type": "string",
      "title": "Conditions d'utilisation"
    },
    "date_debut": {
      "type": "string",
      "format": "date-time",
      "title": "Date d\u00e9but"
    },
    "date_fin": {
      "type": "string",
      "format": "date-time",
      "title": "Date fin"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "enseigne": {
      "type": "string",
      "title": "Enseigne (marque nationale)",
      "enum": [
        "Carrefour",
        "Auchan",
        "Leclerc",
        "Lidl",
        "Intermarch\u00e9",
        "Monoprix",
        "Casino",
        "Picard",
        "IKEA",
        "Leroy Merlin",
        "Decathlon",
        "Zara",
        "H&M",
        "Uniqlo",
        "Fnac",
        "Darty",
        "Sephora",
        "Nocib\u00e9",
        "Go Sport",
        "McDonald's",
        "Autre"
      ]
    },
    "est_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "est_urgente": {
      "type": "boolean",
      "title": "Offre flash",
      "default": false
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Photos de l\u2019offre"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "nb_clics": {
      "type": "number",
      "title": "Clics",
      "default": 0
    },
    "nb_conversions": {
      "type": "number",
      "title": "Conversions",
      "default": 0
    },
    "nb_vues": {
      "type": "number",
      "title": "Vues",
      "default": 0
    },
    "owner_id": {
      "type": "string",
      "title": "Compte propri\u00e9taire"
    },
    "prix_original": {
      "type": "number",
      "title": "Prix original (\u20ac)"
    },
    "prix_promo": {
      "type": "number",
      "title": "Prix promo (\u20ac)"
    },
    "rayon_km": {
      "type": "number",
      "title": "Rayon de diffusion (km)",
      "default": 10
    },
    "source_url": {
      "type": "string",
      "title": "Source officielle"
    },
    "source_nom": {
      "type": "string",
      "title": "Nom de la source"
    },
    "date_verification": {
      "type": "string",
      "format": "date-time",
      "title": "Derni\u00e8re v\u00e9rification"
    },
    "stock_initial": {
      "type": "number",
      "title": "Stock initial"
    },
    "stock_restant": {
      "type": "number",
      "title": "Stock restant"
    },
    "titre": {
      "type": "string",
      "title": "Titre de l'offre"
    },
    "type_reduction": {
      "type": "string",
      "title": "Type de r\u00e9duction",
      "enum": [
        "pourcentage",
        "montant"
      ]
    },
    "valeur_reduction": {
      "type": "number",
      "title": "Valeur r\u00e9duction"
    },
    "ville": {
      "type": "string",
      "title": "Ville"
    }
  },
  "required": [
    "titre",
    "categorie",
    "est_active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}