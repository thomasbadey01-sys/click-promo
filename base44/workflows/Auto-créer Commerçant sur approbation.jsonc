{
  "name": "Auto-cr\u00e9er Commer\u00e7ant sur approbation",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.statut == \"approuve\") and (.trigger.changed_fields | index(\"statut\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DemandeCommercant"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_cr_er_commer_ant_sur_approbation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onDemandeApprouvee",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onDemandeApprouvee"
  }
}